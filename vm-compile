#!/usr/bin/env bash
# Compile a host C file into a static executable suitable for the VM.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: ./vm-compile SOURCE.c [OUTPUT]

Compile SOURCE.c as a static Linux executable. OUTPUT defaults to SOURCE
without its .c suffix.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

source_file="${1:-}"
output_file="${2:-${source_file%.c}}"
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  usage >&2
  exit 2
fi
if [ "$(uname -s)" != "Linux" ]; then
  echo '[-] vm-compile runs on Linux only.' >&2
  exit 1
fi
if [ ! -f "$source_file" ]; then
  echo "[-] Source file not found: $source_file" >&2
  exit 1
fi
case "$source_file" in
  *.c) ;;
  *) echo "[-] Source file must end in .c: $source_file" >&2; exit 2 ;;
esac

mkdir -p "$(dirname "$output_file")"
gcc -static -O2 -Wall -Wextra -o "$output_file" "$source_file"
chmod 0755 "$output_file"
echo "[+] Compiled: $output_file"
echo "[+] Run it in the VM: $SCRIPT_DIR/launch.sh --test $output_file"
